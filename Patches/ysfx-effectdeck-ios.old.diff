+      VM_OP(USERSTACK_POP)
+        {
+          UINT_PTR *sptr = *(UINT_PTR **)iptr;
+          *p1 = *(EEL_F *)*sptr;
+          (*sptr) -= 8;
+          (*sptr) &= *(UINT_PTR*)(iptr+sizeof(void *));
+          (*sptr) |= *(UINT_PTR*)(iptr+2*sizeof(void *));
+        }
+        iptr += sizeof(void*)*3;
+      VM_NEXT;
+      VM_OP(USERSTACK_POPFAST)
+        {
+          UINT_PTR *sptr = *(UINT_PTR **)iptr;
+          p1 = (EEL_F *)*sptr;
+          (*sptr) -= 8;
+          (*sptr) &= *(UINT_PTR*)(iptr+sizeof(void *));
+          (*sptr) |= *(UINT_PTR*)(iptr+2*sizeof(void *));
+        }
+        iptr += sizeof(void*)*3;
+      VM_NEXT;
+      VM_OP(USERSTACK_PEEK)
+        {
+          UINT_PTR sptr = **(UINT_PTR **)iptr;
+          sptr -= sizeof(EEL_F) * (int)(fp_pop());
+          sptr &= *(UINT_PTR*)(iptr+sizeof(void *));
+          sptr |= *(UINT_PTR*)(iptr+2*sizeof(void *));
+          p1 = (EEL_F *)sptr;
+        }
+        iptr += sizeof(void*)*3;
+      VM_NEXT;
+      VM_OP(USERSTACK_PEEK_INT)
+        {
+          UINT_PTR sptr = **(UINT_PTR **)iptr;
+          sptr -= *(UINT_PTR*)(iptr+sizeof(void*));
+          sptr &= *(UINT_PTR*)(iptr+2*sizeof(void *));
+          sptr |= *(UINT_PTR*)(iptr+3*sizeof(void *));
+          p1 = (EEL_F *)sptr;
+        }
+        iptr += sizeof(void*)*4;
+      VM_NEXT;
+      VM_OP(USERSTACK_PEEK_TOP)
+        p1 = **(EEL_F ***)iptr;
+        iptr += sizeof(void*);
+      VM_NEXT;
+      VM_OP(USERSTACK_EXCH)
+        {
+          EEL_F *p=**(EEL_F ***)iptr;
+          EEL_F a=*p;
+          *p=*p1;
+          *p1=a;
+        }
+        iptr += sizeof(void*);
+      VM_NEXT;
+#if !EEL_VM_GOTO
+      }
+    }
+#endif
+vm_frame_done:
+    if (post) post(cbctx, frame);
+  }
+}
