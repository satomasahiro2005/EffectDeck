+++ b/thirdparty/WDL/source/WDL/eel2/glue_port_vm.h
@@ -0,0 +1,811 @@
+// glue_port_vm.h — EffectDeck: glue_port.h のバイトコードを解く別の実行系（ns-eel.h の NSEEL_EXEC_*）。
+//
+// **バイトコードと字句・構文・compile は WDL のまま。**解き方だけ替える。
+// nseel-compiler.c が EEL_VM_FUNC・EEL_VM_GOTO・EEL_VM_FPREG を決めて何度か読む（読むたびに関数が 1 つ増える）。
+//   EEL_VM_FUNC   作る関数の名前
+//   EEL_VM_GOTO   0: switch（GLUE_CALL_CODE と同じ）。1: computed goto（ラベルの番地の表。各命令の終わりで
+//                 次を引いて飛ぶ。実行時に機械語は作らない）
+//   EEL_VM_FPREG  1: 浮動小数の積み場の先頭をローカル（レジスタ）に置く。メモリには先頭より下だけ
+//   EEL_VM_MASK   1: goto の表を 128 に取り、番号の下 7 bit で引く（範囲の比較と選択を省く）。0..127 は
+//                 比べる版と同じ（表の空きは何もしない）。128 以上と負の番号は別の命令に化けるが、
+//                 compile が書く番号は EEL_BC_*（1..EEL_BC_DBG_GETSTACKPTR）だけで、即値は各命令が飛ばす
+// どれも 1 回の呼び出しで nframes 回まわす。GLUE_CALL_CODE の用意（64 KiB の積み場。Darwin の arm64 は
+// ___chkstk_darwin で頁ごとに触る）は 1 回だけ。各回の頭の状態は GLUE_CALL_CODE を呼び直したのと同じ
+// （iptr・stackptr・p1..p3・wtp・積み場の深さ。積み場の中身は前の回の残り＝もとも前の呼び出しの残り）。
+// 回の前後で pre(ctx, i) / post(ctx, i) を呼ぶ（ysfx の spl の読み書き）。
+// **1 命令の中身は glue_port.h の GLUE_CALL_CODE と同じ式にする。あちらを変えたらここも。**
+// 式を変えると FMA の縮約（-ffp-contract=on は 1 つの式の中だけ）や評価の順が変わりうる。
+
+#ifndef EEL_VM_FUNC
+#error "EEL_VM_FUNC を決めてから読む"
+#endif
+
+#if EEL_VM_GOTO
+  #define VM_OP(x) vm_op_##x:
+  #define VM_NEXT VM_DISPATCH()
+#else
+  #define VM_OP(x) case EEL_BC_##x:
+  #define VM_NEXT break
+#endif
+
+#ifdef NSEEL_VM_PROFILE
+  #define VM_PROFILE(inst) do { \
+      unsigned int vm_i_ = (unsigned int)(inst) < EEL_VM_NOPS ? (unsigned int)(inst) : 0; \
+      nseel_vm_profile_ops[vm_i_]++; nseel_vm_profile_pairs[vm_prev][vm_i_]++; vm_prev = vm_i_; } while (0)
+#else
+  #define VM_PROFILE(inst) do { } while (0)
+#endif
+
+#if EEL_VM_GOTO && EEL_VM_MASK
+  #define VM_TAB_SIZE 128
+  #define VM_TAB_INDEX(inst) ((unsigned int)(inst) & (VM_TAB_SIZE - 1))
+#elif EEL_VM_GOTO
+  #define VM_TAB_SIZE EEL_VM_NOPS
+  #define VM_TAB_INDEX(inst) ((unsigned int)(inst) < EEL_VM_NOPS ? (unsigned int)(inst) : 0)
+#endif
+#if EEL_VM_GOTO
+  // 表の外（0 と知らない番号）は switch で当たる case が無いのと同じく何もしない。
+  #define VM_DISPATCH() do { \
+      inst = *(EEL_BC_TYPE *)iptr; \
+      iptr += sizeof(EEL_BC_TYPE); \
+      VM_PROFILE(inst); \
+      goto *vm_tab[VM_TAB_INDEX(inst)]; \
+    } while (0)
+#endif
+
+#if EEL_VM_FPREG
+  // 要素 e0..ek。ek は _fpt、e0..e(k-1) は _fpsp[-k]..._fpsp[-1]。_fpsp は ek の置き場（中身は使わない）。
