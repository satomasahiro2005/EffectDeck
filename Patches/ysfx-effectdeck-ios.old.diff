+// **座標は int にする前に ±2^28 へ収める。** 範囲外の double から int への変換は未定義で、
+// arm64 では INT_MIN/INT_MAX に張り付く。LICE はその値の差や +1 を int のまま取るので
+// 符号付きの桁あふれになり、範囲の検査が最適化で消えて画面の外を読み書きする
+// (gfx_blurto → LICE_Blur、gfx_triangle → FillClippedTrapezoid、回した gfx_blit → LICE_RotatedBlit)。
+// 画像は 2048 px までなので、この幅の中なら切り取られる結果は同じ。NaN は今までどおり 0。
+// **スクリプトの値を画素の座標・大きさにする口は全部これを通す**(線・矩形・円・弧・三角形・
+// blit の元と先・文字の位置)。±2^28 の中の値は何も変えない。
+static const EEL_F k_effectdeck_gfx_coord_limit = (EEL_F)(1<<28);
+static EEL_F effectdeck_gfx_coord(EEL_F v)
+{
+  if (v != v) return 0.0;
+  return v < -k_effectdeck_gfx_coord_limit ? -k_effectdeck_gfx_coord_limit :
+         v > k_effectdeck_gfx_coord_limit ? k_effectdeck_gfx_coord_limit : v;
+}
+
+// 位置と幅(矩形、blit の元と先)は両端を収める。幅だけを収めると、画面の外から大きく
+// はみ出した矩形が画面に掛からなくなる。両端とも範囲の中なら何もしない(足して引くと
+// 丸めで幅が変わりうる)。
+static void effectdeck_gfx_span(EEL_F *pos, EEL_F *len)
+{
+  if (fabs(*pos) <= k_effectdeck_gfx_coord_limit && fabs(*pos + *len) <= k_effectdeck_gfx_coord_limit) return;
+  const EEL_F p = *pos == *pos ? *pos : 0.0, l = *len == *len ? *len : 0.0;
+  *pos = effectdeck_gfx_coord(p);
+  *len = effectdeck_gfx_coord(p + l) - *pos;
+}
+
+// 線分は端点を別々に収めると向きが変わる。箱の外の端点は、線分に沿って箱の縁まで寄せる
+// (Liang-Barsky)。箱の中の端点から測る(外の大きな値から測ると桁が落ちる)。箱は ±(2^30-1)
+// (LICE_ClipLine が取る端点の差が int に収まる幅)で、両端とも箱の中なら何もしない。
+// 箱に掛からない線分は画面にも掛からないので false。
+static bool effectdeck_gfx_segment(EEL_F *x1, EEL_F *y1, EEL_F *x2, EEL_F *y2)
+{
+  const EEL_F lim = (EEL_F)((1<<30)-1);
+  EEL_F *v[4] = { x1, y1, x2, y2 };
+  for (int i = 0; i < 4; i ++)
+  {
+    if (*v[i] != *v[i]) *v[i] = 0.0; // NaN は今までどおり 0
+    else if (*v[i] > 1e300) *v[i] = 1e300; // ±Inf でも差を有限にする
+    else if (*v[i] < -1e300) *v[i] = -1e300;
+  }
+  const bool in1 = fabs(*x1) <= lim && fabs(*y1) <= lim, in2 = fabs(*x2) <= lim && fabs(*y2) <= lim;
+  if (in1 && in2) return true;
+  const bool from2 = !in1 && in2;
+  const EEL_F ox = from2 ? *x2 : *x1, oy = from2 ? *y2 : *y1;
+  const EEL_F dx = (from2 ? *x1 : *x2) - ox, dy = (from2 ? *y1 : *y2) - oy;
+  const EEL_F p[4] = { -dx, dx, -dy, dy }, q[4] = { ox + lim, lim - ox, oy + lim, lim - oy };
+  EEL_F t0 = 0.0, t1 = 1.0;
+  for (int i = 0; i < 4; i ++)
+  {
+    if (p[i] == 0.0) { if (q[i] < 0.0) return false; }
+    else if (p[i] < 0.0) { const EEL_F t = q[i] / p[i]; if (t > t0) t0 = t; }
+    else { const EEL_F t = q[i] / p[i]; if (t < t1) t1 = t; }
+  }
+  if (t0 > t1) return false;
+  EEL_F e[4] = { ox + t0*dx, oy + t0*dy, ox + t1*dx, oy + t1*dy };
+  for (int i = 0; i < 4; i ++) e[i] = e[i] < -lim ? -lim : e[i] > lim ? lim : e[i]; // 丸めの分
+  *x1 = from2 ? e[2] : e[0]; *y1 = from2 ? e[3] : e[1];
+  *x2 = from2 ? e[0] : e[2]; *y2 = from2 ? e[1] : e[3];
+  return true;
+}
