+        if (m_overflow || m_buffer->size() + 4 + length > k_effectdeck_serialize_limit) {
+            m_overflow = true;
+            return 0;
+        }
+#endif
+        uint8_t size[4];
+        ysfx::pack_u32le(length, size);
+        m_buffer->append((char *)size, sizeof(size));
+        m_buffer->append(str.data(), length);
+        return length;
+    }
+    if (m_write == 0) {
+        if (m_pos + 4 > m_buffer->size()) return 0;
+        const uint32_t length = ysfx::unpack_u32le((uint8_t *)&(*m_buffer)[m_pos]);
+        m_pos += 4;
+        if (length > 1024 * 1024 || m_pos + length > m_buffer->size()) {
+            m_pos = m_buffer->size();
+            return 0;
+        }
+        str.assign(m_buffer->data() + m_pos, length);
+        m_pos += length;
+        return length;
+    }
     return 0;
 }
 
