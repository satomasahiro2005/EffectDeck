desc:jsfx-bench --diff: vm-reg の畳み込み・行き先じか書き・まとめ・升の使い回しが portable の順を崩さないかを突く形
slider1:0.5<0,1,0.001>Amount
slider2:3<0,8,1>Mode
slider3:-2<-40,40,0.5>Shift
in_pin:L
in_pin:R
out_pin:L
out_pin:R

@init
buf = 4096;
big = (1*10^(300));
// loop / while の数: 負・小数・NaN・巨大（頭打ち）
c0 = 0; loop(-1, c0 += 1);
c1 = 0; loop(0.999, c1 += 1);
c2 = 0; loop(0/0, c2 += 1);
c3 = 0; loop(2.9, c3 += 1);
c4 = 0; loop(big, c4 += 1);
c5 = 0; while (c5 += 1; 1);
c6 = 0; while (c6 < (1*10^(9))) ( c6 += 1; );
nested = 0; i = 0;
loop(4, j = 0; loop(i + 1, nested += i * 10 + j; j += 1;); i += 1;);
// 範囲の外の megabuf（nseel_ramalloc_onfail に書いてすぐ読む）
buf[-1] = 7; oob1 = buf[-1];
buf[(1*10^(12))] = 9; oob2 = buf[(1*10^(12))];
memset(buf, 0, 256);
stack_push(0);

function fbig(x) local(t u) (
  t = x; u = 1;
  t = t * 1.0001 + x * 0.50 - u / 3; u = u * 0.999 + t * 0.001;
  t = t * 1.0001 + x * 0.51 - u / 4; u = u * 0.999 + t * 0.002;
  t = t * 1.0001 + x * 0.52 - u / 5; u = u * 0.999 + t * 0.003;
  t = t * 1.0001 + x * 0.53 - u / 6; u = u * 0.999 + t * 0.004;
  t = t * 1.0001 + x * 0.54 - u / 7; u = u * 0.999 + t * 0.005;
  t = t * 1.0001 + x * 0.55 - u / 8; u = u * 0.999 + t * 0.006;
  t = t * 1.0001 + x * 0.56 - u / 9; u = u * 0.999 + t * 0.007;
  t = t * 1.0001 + x * 0.57 - u / 10; u = u * 0.999 + t * 0.008;
  t = t * 1.0001 + x * 0.58 - u / 11; u = u * 0.999 + t * 0.009;
  t = t * 1.0001 + x * 0.59 - u / 12; u = u * 0.999 + t * 0.010;
  t = t * 1.0001 + x * 0.60 - u / 13; u = u * 0.999 + t * 0.011;
  t = t * 1.0001 + x * 0.61 - u / 14; u = u * 0.999 + t * 0.012;
  t = t * 1.0001 + x * 0.62 - u / 15; u = u * 0.999 + t * 0.013;
  t = t * 1.0001 + x * 0.63 - u / 16; u = u * 0.999 + t * 0.014;
  t = t * 1.0001 + x * 0.64 - u / 17; u = u * 0.999 + t * 0.015;
  t = t * 1.0001 + x * 0.65 - u / 18; u = u * 0.999 + t * 0.016;
  t = t * 1.0001 + x * 0.66 - u / 19; u = u * 0.999 + t * 0.017;
  t = t * 1.0001 + x * 0.67 - u / 20; u = u * 0.999 + t * 0.018;
  t = t * 1.0001 + x * 0.68 - u / 21; u = u * 0.999 + t * 0.019;
  t = t * 1.0001 + x * 0.69 - u / 22; u = u * 0.999 + t * 0.020;
  t = t * 1.0001 + x * 0.70 - u / 23; u = u * 0.999 + t * 0.021;
  t = t * 1.0001 + x * 0.71 - u / 24; u = u * 0.999 + t * 0.022;
  t = t * 1.0001 + x * 0.72 - u / 25; u = u * 0.999 + t * 0.023;
  t = t * 1.0001 + x * 0.73 - u / 26; u = u * 0.999 + t * 0.024;
  t = t * 1.0001 + x * 0.74 - u / 27; u = u * 0.999 + t * 0.025;
  t = t * 1.0001 + x * 0.75 - u / 28; u = u * 0.999 + t * 0.026;
  t = t * 1.0001 + x * 0.76 - u / 29; u = u * 0.999 + t * 0.027;
  t = t * 1.0001 + x * 0.77 - u / 30; u = u * 0.999 + t * 0.028;
  t = t * 1.0001 + x * 0.78 - u / 31; u = u * 0.999 + t * 0.029;
  t = t * 1.0001 + x * 0.79 - u / 32; u = u * 0.999 + t * 0.030;
  t = t * 1.0001 + x * 0.80 - u / 33; u = u * 0.999 + t * 0.031;
  t = t * 1.0001 + x * 0.81 - u / 34; u = u * 0.999 + t * 0.032;
  t = t * 1.0001 + x * 0.82 - u / 35; u = u * 0.999 + t * 0.033;
  t = t * 1.0001 + x * 0.83 - u / 36; u = u * 0.999 + t * 0.034;
  t = t * 1.0001 + x * 0.84 - u / 37; u = u * 0.999 + t * 0.035;
  t = t * 1.0001 + x * 0.85 - u / 38; u = u * 0.999 + t * 0.036;
  t = t * 1.0001 + x * 0.86 - u / 39; u = u * 0.999 + t * 0.037;
  t = t * 1.0001 + x * 0.87 - u / 40; u = u * 0.999 + t * 0.038;
  t = t * 1.0001 + x * 0.88 - u / 41; u = u * 0.999 + t * 0.039;
  t = t * 1.0001 + x * 0.89 - u / 42; u = u * 0.999 + t * 0.040;
  t = t * 1.0001 + x * 0.90 - u / 43; u = u * 0.999 + t * 0.041;
  t = t * 1.0001 + x * 0.91 - u / 44; u = u * 0.999 + t * 0.042;
  t = t * 1.0001 + x * 0.92 - u / 45; u = u * 0.999 + t * 0.043;
  t = t * 1.0001 + x * 0.93 - u / 46; u = u * 0.999 + t * 0.044;
  t = t * 1.0001 + x * 0.94 - u / 47; u = u * 0.999 + t * 0.045;
  t = t * 1.0001 + x * 0.95 - u / 48; u = u * 0.999 + t * 0.046;
  t = t * 1.0001 + x * 0.96 - u / 49; u = u * 0.999 + t * 0.047;
  t = t * 1.0001 + x * 0.97 - u / 50; u = u * 0.999 + t * 0.048;
  gcount += 1;
  t + u;
);
function fbig3(a, b, c) local(t) (
  t = a;
  t = t * 1.0001 + a * 0.30 - b / 3 + c * 0.002;
  t = t * 1.0001 + a * 0.31 - b / 4 + c * 0.004;
  t = t * 1.0001 + a * 0.32 - b / 5 + c * 0.006;
  t = t * 1.0001 + a * 0.33 - b / 6 + c * 0.008;
  t = t * 1.0001 + a * 0.34 - b / 7 + c * 0.010;
  t = t * 1.0001 + a * 0.35 - b / 8 + c * 0.012;
  t = t * 1.0001 + a * 0.36 - b / 9 + c * 0.014;
  t = t * 1.0001 + a * 0.37 - b / 10 + c * 0.016;
  t = t * 1.0001 + a * 0.38 - b / 11 + c * 0.018;
  t = t * 1.0001 + a * 0.39 - b / 12 + c * 0.020;
  t = t * 1.0001 + a * 0.40 - b / 13 + c * 0.022;
  t = t * 1.0001 + a * 0.41 - b / 14 + c * 0.024;
  t = t * 1.0001 + a * 0.42 - b / 15 + c * 0.026;
  t = t * 1.0001 + a * 0.43 - b / 16 + c * 0.028;
  t = t * 1.0001 + a * 0.44 - b / 17 + c * 0.030;
  t = t * 1.0001 + a * 0.45 - b / 18 + c * 0.032;
  t = t * 1.0001 + a * 0.46 - b / 19 + c * 0.034;
  t = t * 1.0001 + a * 0.47 - b / 20 + c * 0.036;
  t = t * 1.0001 + a * 0.48 - b / 21 + c * 0.038;
  t = t * 1.0001 + a * 0.49 - b / 22 + c * 0.040;
  t = t * 1.0001 + a * 0.50 - b / 23 + c * 0.042;
  t = t * 1.0001 + a * 0.51 - b / 24 + c * 0.044;
  t = t * 1.0001 + a * 0.52 - b / 25 + c * 0.046;
  t = t * 1.0001 + a * 0.53 - b / 26 + c * 0.048;
  t = t * 1.0001 + a * 0.54 - b / 27 + c * 0.050;
  t = t * 1.0001 + a * 0.55 - b / 28 + c * 0.052;
  t = t * 1.0001 + a * 0.56 - b / 29 + c * 0.054;
  t = t * 1.0001 + a * 0.57 - b / 30 + c * 0.056;
  t = t * 1.0001 + a * 0.58 - b / 31 + c * 0.058;
  t = t * 1.0001 + a * 0.59 - b / 32 + c * 0.060;
  t = t * 1.0001 + a * 0.60 - b / 33 + c * 0.062;
  t = t * 1.0001 + a * 0.61 - b / 34 + c * 0.064;
  t = t * 1.0001 + a * 0.62 - b / 35 + c * 0.066;
  t = t * 1.0001 + a * 0.63 - b / 36 + c * 0.068;
  t = t * 1.0001 + a * 0.64 - b / 37 + c * 0.070;
  t = t * 1.0001 + a * 0.65 - b / 38 + c * 0.072;
  t = t * 1.0001 + a * 0.66 - b / 39 + c * 0.074;
  t = t * 1.0001 + a * 0.67 - b / 40 + c * 0.076;
  t = t * 1.0001 + a * 0.68 - b / 41 + c * 0.078;
  t = t * 1.0001 + a * 0.69 - b / 42 + c * 0.080;
  t = t * 1.0001 + a * 0.70 - b / 43 + c * 0.082;
  t = t * 1.0001 + a * 0.71 - b / 44 + c * 0.084;
  t = t * 1.0001 + a * 0.72 - b / 45 + c * 0.086;
  t = t * 1.0001 + a * 0.73 - b / 46 + c * 0.088;
  t = t * 1.0001 + a * 0.74 - b / 47 + c * 0.090;
  t = t * 1.0001 + a * 0.75 - b / 48 + c * 0.092;
  t = t * 1.0001 + a * 0.76 - b / 49 + c * 0.094;
  t = t * 1.0001 + a * 0.77 - b / 50 + c * 0.096;
  t;
);
function swapper(a*, b*) local(t) ( t = a; a = b; b = t; );
function bump(p*) ( p += 1; p; );

@slider
amt = slider1;
mode = slider2 | 0;
sh = slider3;

@block
bx = 0;
// 読んでから API が同じ変数を書く（mem_get_values・stack_pop）
buf[0] = amt; buf[1] = mode; buf[2] = sh;
ta = bx; mem_get_values(buf, bx, by, bz); r0 = ta + bx * 3 + by - bz;
stack_push(r0); tb = r0; stack_pop(r0); r1 = tb - r0;
stack_exch(r1); tc = r1;

@sample
x = spl0; y = spl1;
// 畳み込み: 読んでから間で書く（定数の番地・megabuf・ポインタ越し）
t = x; x = y * 0.5; s1 = t + x;
t = a1; a1 = a1 * 0.9 + x; a1 += t * 0.1;
t = b1; buf[16] = b1 + 1; b1 = buf[16] * 0.5 + t * 0.25;
// 条件の左辺（phi のポインタ越しに書く）
t = p1v; (x > 0 ? p1v : p2v) = y; s2 = t + p1v - p2v;
t = q1; (y > x ? q1 : q2) += x; s3 = t * q1 + q2;
// min / max の左辺（参照を返す）
m1 = x; m2 = y; t = m1; min(m1, m2) = 0.25; s4 = t + m1 + m2;
max(m1, m2) *= 2; s4 += m1 - m2;
// ユーザーの積み場の参照
stack_push(x); stack_peek(0) = y; t = 0; stack_pop(t); s5 = t;
stack_push(s5); stack_peek(0) += 1; stack_pop(s5);
// 関数（参照引数・大きい関数の FCALL・?: の片方だけが作業表を使う）
u1 = x; u2 = y; swapper(u1, u2); s6 = u1 - u2;
k = 3; bump(k); bump(k); s7 = k;
s8 = mode > 4 ? fbig(x) + fbig(y) * 0.5 : x * sin(y) + cos(x) * atan2(y, x + 1);
s9 = mode & 1 ? (bump(k); fbig(s8)) : (k = 0; s8);
// 行き先じか書き: 同じ升を読む・書く命令が間にある
d1 = d1 * 0.5 + x; d2 = d1; d1 = d2 * d1 + y;
d3 = (d4 = x + y) * 2; d4 = d3 - d4;
e1 = x; e1 = e1 + e1; e1 = e1 * e1 - e1;
// 非正規化数・NaN・Inf の代入（フィルタ）
den = x * (1*10^(-308)) * amt; f1 = den; f2 = den * 0.5; f3 += den; f4 = (den += den);
nn = (mode == 7) ? 0/0 : x; f5 = nn; f6 = nn * 0; f7 = nn + (1*10^(300)) * (1*10^(300));
// 整数の演算: シフト・余り・ビット
i1 = x * 1000; i2 = sh;
g1 = i1 << i2; g2 = i1 >> i2; g3 = (i1 * (1*10^(15))) | 0; g4 = i1 % i2; g5 = (i1 * (1*10^(12))) % (i2 * (1*10^(9)));
g6 = i1 & i2; g7 = i1 ~ (i2 * 3); g8 = (i1 * (1*10^(19))) & 255; g9 = (0/0) | 0; g10 = (-(1*10^(30))) >> 3;
g11 = 5 % (0/0); g12 = (0/0) % 7; g13 = (i1 << 33) >> 33;
// invsqrt・sign・比べ
h1 = invsqrt(x); h2 = invsqrt(-x); h3 = invsqrt(x * (1*10^(-310))); h4 = sign(x - y);
h5 = (x == y + (1*10^(-11))); h6 = (x === y); h7 = (x != y * (1 + (1*10^(-12)))); h8 = (x !== x);
h9 = (x < y) + (x <= y) * 2 + (x > y) * 4 + (x >= y) * 8 + !x * 16 + (x && y) * 32 + (x || y) * 64;
// megabuf の番地の計算と読み書きの順
idx = (abs(x) * 100) | 0; buf[idx + 32] = buf[idx + 33] + 1; buf[idx + 33] = buf[idx + 32] * 0.5;
w = buf[(idx += 1) + 40]; buf[idx + 40] = idx;
// 入れ子の loop（升の写し・ループの数）
acc = 0; i = 0;
loop(mode + 1, j = i; loop(2, acc += j * x; j += 1;); i += 1;);
z = 0; while (z < mode) ( z += 1; acc += z * y; );
spl0 = s1 * 0.1 + s2 * 0.01 + s4 * 0.001 + s6 + s8 * 0.01 + acc * 0.001 + h1 * (1*10^(-6));
spl1 = s3 * 0.01 + s5 + s7 * 0.001 + s9 * 0.01 + d1 * (1*10^(-3)) + e1 * (1*10^(-3)) + g1 * (1*10^(-9)) + w * (1*10^(-6));
// 1 つの式の中で、積んだ値を読んだあとに同じ変数を書く（畳み込みを断るべき所）
o1 = x; o2 = y;
r1 = o1 + (o1 = o2 * 3);
r2 = o2 * (o2 += 1) - o2;
r3 = o1 + (o3 = o1 + 1) + (o1 = o3 * 2) + o1;
r4 = o1 - ((x > 0 ? o1 : o2) = 2) + o1;
r5 = o2 + (min(o1, o2) = 9) + o2;
r6 = k + bump(k) + k;
r7 = gcount + (mode > 6 ? fbig(o1) : 0) + gcount;
r8 = bx + mem_get_values(buf, bx) + bx;
r9 = o1 + (stack_push(o2); stack_pop(o1); 0) + o1;
r10 = o2 + (stack_push(7); stack_exch(o2); stack_pop(o3); o3) + o2;
r11 = buf[3] + (buf[3] = o1) + buf[3];
r12 = o1 + (swapper(o1, o2); o2) + o1;
r13 = (o1 = o1 * 0.5 + 1) + (o1 = o1 * 0.5 + 1) + o1;
r14 = sin(o1) + (o1 = o2) + cos(o1);
r15 = o1 ~ (o1 = o1 + 2);
r16 = o1 % (o1 = o1 * 7 + 3) + (o1 |= 5) + (o1 &= 6) + (o1 ~= 3) + (o1 %= 4) + o1;
r17 = o1 + (o1 += o1) + (o1 *= o1) + (o1 -= o1) + (o1 /= o2) + o1;
spl0 += (r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10 + r11 + r12 + r13 + r14 + r15 + r16 + r17) * (1*10^(-9));
// 段 1 のコーパスで一度も通らなかった命令（DIV_OP_FAST・BNOT・PUSH_P1PTR_AS_VALUE・GENERIC2PARM など）
o1 = x + 2; o1 /= 0.5; o1 /= -0.25; o2 = y; o2 *= 3; o2 *= -1.5; o2 -= 2; o2 += 3;
v1 = !(x == y) + !(x < y) * 2 + !(x === y) * 4 + !(spl0 && y) * 8 + !(mode > 3 || x > 0) * 16;
v2 = fbig3((o1 = x), (o2 = y), x + y) + fbig3(o1 += 1, max(o1, o2), min(o1, o2));
v3 = fbig3(min(x * 2, y * 3), max(x * 2, y * 3), (o3 = abs(x) + 1) ^ 1.5);
o3 ^= 1.5; o3 = min(o3, 1000);
buf[512] = x; buf[513] = y; buf[514] = o1; buf[515] = o2;
fft_permute(buf + 512, 16); fft(buf + 512, 16); ifft(buf + 512, 16); fft_ipermute(buf + 512, 16);
v4 = buf[512] + buf[513] * 0.5;
memset(buf + 600 + (idx & 15), x * 2, 3 + (mode & 3));
memcpy(buf + 700, buf + 600 + (idx & 7), (mode & 7) + 1);
v5 = buf[700] + buf[703];
slider(2 + (mode > 9)) += 0; v6 = slider(2) + spl(x > 0);
stack_push(x); stack_push(y); stack_push(o3);
v7 = stack_peek(mode & 1) + stack_peek(1) * 2 + stack_peek(0) * 3;
stack_pop(); stack_pop(); v8 = stack_pop();
gmem[100 + (idx & 15)] = x; v9 = gmem[100 + (idx & 15)];
spl1 += (v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9) * (1*10^(-9));
