desc:jsfx-bench --diff: opcodes.jsfx から __dbg_getstackptr を抜いて、持ち上げ（Sources/JSFXVM）の形を足したもの
slider1:0.5<0,1,0.01>Amount
slider2:3<0,8,1>Mode
in_pin:L
in_pin:R
out_pin:L
out_pin:R

@init
buf = 1000;
gbase = 64;
// gmem はプロセスの中で全部の実体が共有する（前の回の残りが見える）。読む所は先に書く
i = 0; loop(16, gmem[gbase + i] = i * 0.5; i += 1;);
n = 0;
acc = 0;
memset(buf, 0, 512);
i = 0;
loop(512, buf[i] = sin(i * 0.1) * (i % 7 - 3); i += 1;);
seed = rand(10);

function f1(x) local(t) ( t = x * x + 1; t / (abs(x) + 1); );
function f2(a, b) local(u v) ( u = a - b; v = a + b; u > v ? u : v; );
function acc_add(x) instance(total count) ( total += x; count += 1; total / count; );
// 2048 バイトを超える関数は inline されず FCALL で呼ばれる
function big(x) local(t u) (
  t = x; u = 1;
  t = t * 1.0001 + x * 0.50 - u / 3; u = u * 0.999 + t * 0.001;
  t = t * 1.0001 + x * 0.51 - u / 4; u = u * 0.999 + t * 0.002;
  t = t * 1.0001 + x * 0.52 - u / 5; u = u * 0.999 + t * 0.003;
  t = t * 1.0001 + x * 0.53 - u / 6; u = u * 0.999 + t * 0.004;
  t = t * 1.0001 + x * 0.54 - u / 7; u = u * 0.999 + t * 0.005;
  t = t * 1.0001 + x * 0.55 - u / 8; u = u * 0.999 + t * 0.006;
  t = t * 1.0001 + x * 0.56 - u / 9; u = u * 0.999 + t * 0.007;
  t = t * 1.0001 + x * 0.57 - u / 10; u = u * 0.999 + t * 0.008;
  t = t * 1.0001 + x * 0.58 - u / 11; u = u * 0.999 + t * 0.009;
  t = t * 1.0001 + x * 0.59 - u / 12; u = u * 0.999 + t * 0.010;
  t = t * 1.0001 + x * 0.60 - u / 13; u = u * 0.999 + t * 0.011;
  t = t * 1.0001 + x * 0.61 - u / 14; u = u * 0.999 + t * 0.012;
  t = t * 1.0001 + x * 0.62 - u / 15; u = u * 0.999 + t * 0.013;
  t = t * 1.0001 + x * 0.63 - u / 16; u = u * 0.999 + t * 0.014;
  t = t * 1.0001 + x * 0.64 - u / 17; u = u * 0.999 + t * 0.015;
  t = t * 1.0001 + x * 0.65 - u / 18; u = u * 0.999 + t * 0.016;
  t = t * 1.0001 + x * 0.66 - u / 19; u = u * 0.999 + t * 0.017;
  t = t * 1.0001 + x * 0.67 - u / 20; u = u * 0.999 + t * 0.018;
  t = t * 1.0001 + x * 0.68 - u / 21; u = u * 0.999 + t * 0.019;
  t = t * 1.0001 + x * 0.69 - u / 22; u = u * 0.999 + t * 0.020;
  t = t * 1.0001 + x * 0.70 - u / 23; u = u * 0.999 + t * 0.021;
  t = t * 1.0001 + x * 0.71 - u / 24; u = u * 0.999 + t * 0.022;
  t = t * 1.0001 + x * 0.72 - u / 25; u = u * 0.999 + t * 0.023;
  t = t * 1.0001 + x * 0.73 - u / 26; u = u * 0.999 + t * 0.024;
  t = t * 1.0001 + x * 0.74 - u / 27; u = u * 0.999 + t * 0.025;
  t = t * 1.0001 + x * 0.75 - u / 28; u = u * 0.999 + t * 0.026;
  t = t * 1.0001 + x * 0.76 - u / 29; u = u * 0.999 + t * 0.027;
  t = t * 1.0001 + x * 0.77 - u / 30; u = u * 0.999 + t * 0.028;
  t = t * 1.0001 + x * 0.78 - u / 31; u = u * 0.999 + t * 0.029;
  t = t * 1.0001 + x * 0.79 - u / 32; u = u * 0.999 + t * 0.030;
  t = t * 1.0001 + x * 0.80 - u / 33; u = u * 0.999 + t * 0.031;
  t = t * 1.0001 + x * 0.81 - u / 34; u = u * 0.999 + t * 0.032;
  t = t * 1.0001 + x * 0.82 - u / 35; u = u * 0.999 + t * 0.033;
  t = t * 1.0001 + x * 0.83 - u / 36; u = u * 0.999 + t * 0.034;
  t = t * 1.0001 + x * 0.84 - u / 37; u = u * 0.999 + t * 0.035;
  t = t * 1.0001 + x * 0.85 - u / 38; u = u * 0.999 + t * 0.036;
  t = t * 1.0001 + x * 0.86 - u / 39; u = u * 0.999 + t * 0.037;
  t = t * 1.0001 + x * 0.87 - u / 40; u = u * 0.999 + t * 0.038;
  t = t * 1.0001 + x * 0.88 - u / 41; u = u * 0.999 + t * 0.039;
  t = t * 1.0001 + x * 0.89 - u / 42; u = u * 0.999 + t * 0.040;
  t = t * 1.0001 + x * 0.90 - u / 43; u = u * 0.999 + t * 0.041;
  t = t * 1.0001 + x * 0.91 - u / 44; u = u * 0.999 + t * 0.042;
  t = t * 1.0001 + x * 0.92 - u / 45; u = u * 0.999 + t * 0.043;
  t = t * 1.0001 + x * 0.93 - u / 46; u = u * 0.999 + t * 0.044;
  t = t * 1.0001 + x * 0.94 - u / 47; u = u * 0.999 + t * 0.045;
  t = t * 1.0001 + x * 0.95 - u / 48; u = u * 0.999 + t * 0.046;
  t = t * 1.0001 + x * 0.96 - u / 49; u = u * 0.999 + t * 0.047;
  t = t * 1.0001 + x * 0.97 - u / 50; u = u * 0.999 + t * 0.048;
  t + u;
);

function big3(x, y, z) local(t) (
  t = x;
  t = t * 1.0001 + x * 0.30 - y / 3 + z * 0.002;
  t = t * 1.0001 + x * 0.31 - y / 4 + z * 0.004;
  t = t * 1.0001 + x * 0.32 - y / 5 + z * 0.006;
  t = t * 1.0001 + x * 0.33 - y / 6 + z * 0.008;
  t = t * 1.0001 + x * 0.34 - y / 7 + z * 0.010;
  t = t * 1.0001 + x * 0.35 - y / 8 + z * 0.012;
  t = t * 1.0001 + x * 0.36 - y / 9 + z * 0.014;
  t = t * 1.0001 + x * 0.37 - y / 10 + z * 0.016;
  t = t * 1.0001 + x * 0.38 - y / 11 + z * 0.018;
  t = t * 1.0001 + x * 0.39 - y / 12 + z * 0.020;
  t = t * 1.0001 + x * 0.40 - y / 13 + z * 0.022;
  t = t * 1.0001 + x * 0.41 - y / 14 + z * 0.024;
  t = t * 1.0001 + x * 0.42 - y / 15 + z * 0.026;
  t = t * 1.0001 + x * 0.43 - y / 16 + z * 0.028;
  t = t * 1.0001 + x * 0.44 - y / 17 + z * 0.030;
  t = t * 1.0001 + x * 0.45 - y / 18 + z * 0.032;
  t = t * 1.0001 + x * 0.46 - y / 19 + z * 0.034;
  t = t * 1.0001 + x * 0.47 - y / 20 + z * 0.036;
  t = t * 1.0001 + x * 0.48 - y / 21 + z * 0.038;
  t = t * 1.0001 + x * 0.49 - y / 22 + z * 0.040;
  t = t * 1.0001 + x * 0.50 - y / 23 + z * 0.042;
  t = t * 1.0001 + x * 0.51 - y / 24 + z * 0.044;
  t = t * 1.0001 + x * 0.52 - y / 25 + z * 0.046;
  t = t * 1.0001 + x * 0.53 - y / 26 + z * 0.048;
  t = t * 1.0001 + x * 0.54 - y / 27 + z * 0.050;
  t = t * 1.0001 + x * 0.55 - y / 28 + z * 0.052;
  t = t * 1.0001 + x * 0.56 - y / 29 + z * 0.054;
  t = t * 1.0001 + x * 0.57 - y / 30 + z * 0.056;
  t = t * 1.0001 + x * 0.58 - y / 31 + z * 0.058;
  t = t * 1.0001 + x * 0.59 - y / 32 + z * 0.060;
  t = t * 1.0001 + x * 0.60 - y / 33 + z * 0.062;
  t = t * 1.0001 + x * 0.61 - y / 34 + z * 0.064;
  t = t * 1.0001 + x * 0.62 - y / 35 + z * 0.066;
  t = t * 1.0001 + x * 0.63 - y / 36 + z * 0.068;
  t = t * 1.0001 + x * 0.64 - y / 37 + z * 0.070;
  t = t * 1.0001 + x * 0.65 - y / 38 + z * 0.072;
  t = t * 1.0001 + x * 0.66 - y / 39 + z * 0.074;
  t = t * 1.0001 + x * 0.67 - y / 40 + z * 0.076;
  t = t * 1.0001 + x * 0.68 - y / 41 + z * 0.078;
  t = t * 1.0001 + x * 0.69 - y / 42 + z * 0.080;
  t = t * 1.0001 + x * 0.70 - y / 43 + z * 0.082;
  t = t * 1.0001 + x * 0.71 - y / 44 + z * 0.084;
  t = t * 1.0001 + x * 0.72 - y / 45 + z * 0.086;
  t = t * 1.0001 + x * 0.73 - y / 46 + z * 0.088;
  t = t * 1.0001 + x * 0.74 - y / 47 + z * 0.090;
  t = t * 1.0001 + x * 0.75 - y / 48 + z * 0.092;
  t = t * 1.0001 + x * 0.76 - y / 49 + z * 0.094;
  t = t * 1.0001 + x * 0.77 - y / 50 + z * 0.096;
  t;
);
function addp(p) ( p += 1; );
function swp(a b) local(t) ( t = a; a = b; b = t; a - b; );
function step(x) instance(st) ( st = st * 0.5 + x; st; );
@slider
amt = slider1;
mode = slider2 | 0;
amt_i = invsqrt(amt + 0.25);

@block
blk += 1;
blk_mod = blk % 5;
// 利用者の積み場はコードの塊ごとで、中身は 0 に初期化されない。積んだ分だけ読む
stack_push(blk); stack_push(blk * 2); blk & 1 ? (stack_exch(blk + 1); stack_peek(0) += 0.5;); bs = stack_pop() + stack_pop();
memcpy(buf + 256, buf, 64);
gmem[gbase + (blk % 16)] = blk * 0.25;
s = sprintf(#tmp, "%d:%.3f", blk, amt);
blen = strlen(#tmp);

@sample
x = spl0; y = spl1;
n += 1;
// 四則と比べ合わせ
a = x * amt + y * (1 - amt) - x / (abs(y) + 2);
b = a == x ? 1 : a === y ? 2 : a != y ? 3 : a !== x ? 4 : 5;
c = (a > 0.1) + (a < -0.1) * 2 + (a >= 0) * 4 + (a <= 0) * 8;
d = !(a > 0) && (b < 4) || (c == 8);
e = min(a, b) + max(c, d) + sign(a) + sqr(a) + -a;
// 整数の演算
k = (n & 255) | 3;
k ~= 0x55;
k = k << 1; k = k >> 2;
k2 = (k << 3) >> 1;
k3 = (n % 13);
k3 %= 5;
k3 |= 8; k3 &= 12;
k4 = (a * 1000) | 0;
// 代入の演算
acc += a * 0.001;
acc -= b * 0.0001;
acc *= 0.999;
acc /= 1.0001;
acc ^= 1;
// 関数
f = f1(a) + f2(a, b) + pow(abs(a), 0.3) + atan2(a, b + 1) + exp(-abs(a)) + log(abs(a) + 1) + floor(a * 10) + ceil(a) + sqrt(abs(a));
m.acc_add(a);
g = big(a) * 0.001 + big(b) * 0.001;
// メモリ
idx = (n % 300) | 0;
buf[idx] = buf[idx] * 0.5 + a;
h = buf[(idx + 17) % 300] + gmem[gbase + (n % 16)];
// 繰り返し
loop(mode + 1, h += 0.01;);
w = 0;
while (w < mode) ( w += 1; h -= 0.003; );
j = 0;
while ( j += 1; j < 3; );
// 引数が式の呼び出し・文字列・メモリの関数・積み場の pop(var)・ポインタの min/max
k5 = k ~ 7;
cnt = 1 + (n & 3); cnt *= 2; cnt /= 2; cnt *= a; cnt /= (abs(b) + 1);
z = buf[idx]; zz = z; zz = buf[(idx + 1) % 300];
mx1 = a; mx2 = b; max(mx1, mx2) += 1; min(mx1, mx2) -= 1;
p3 = big3(a + b, c * d - e, (n % 7) ? x : y);
memset(buf + 600 + (n % 8) * 2, a > 0 ? 1 : 2, (n % 3) + 1);
nb = !(a < b) + !k3 + !!c;
(a * 2) ? zz += 1;
fl = (n % 4) ? 1 : 0;
strcpy(#s1, "abc"); strcat(#s1, "d"); strncat(#s1, "efg", 1 + (n % 2));
sc = strcmp(#s1, "abcd") + stricmp(#s1, "ABCD") + str_getchar(#s1, n % 3) + strlen(#s1);
mt = match("ab*", #s1);
sprintf(#t2, "%d-%d", n % 10, k3); str_setchar(#s1, 0, 'x'); strcpy_substr(#s2, #s1, 1, 2); strncpy(#s3, #t2, 2);
sc += strlen(#t2) + strlen(#s2) + strlen(#s3);
ss = sum_prod = mem_multiply_sum(buf, buf + 256, 8);
stack_push(a); stack_pop(zp);
freembuf(1500000);
stack_push(a); stack_push(b); stack_push(c);
mode == 0 ? (q = 1;) : mode == 1 ? (q = 2;) : (q = stack_peek(1) + stack_peek(k3 & 1));
stack_exch(x);
v = stack_pop(); stack_push(v + 0.125); v += stack_pop() + stack_pop() + stack_pop();
amt_i > 1 ? spl0 = x + 0.0001 * (e + f + g + h + q + k2 + k3 + k4 + acc + amt_i + m.total) : spl0 = x - 0.0001 * (e + f);
spl1 = y * 0.9 + 0.0001 * (c + d + w + v + bs + blen + k5 + cnt + zz + mx1 + mx2 + p3 * 0.001 + nb + fl + sc + mt + ss + zp);

// 持ち上げの形: 式の引数（値で渡す）・枝の中の一時・回らない loop の値（前の p1）・枝の中の varparm・
// 参照の ?: への代入・関数の instance
vv = addp(buf[idx]) + swp(a + 1, b * 2) + one.step(a) + two.step(b);
tt = (n & 1) ? (buf[(idx + 1) % 300] + (a * 3)) * (b - 1) : 2;
lp = loop(0, h += 1);
lw = (n & 4) ? loop((n & 3), tt += 0.5) : 0;
pp = (n & 2) ? sprintf(#t3, "%d", n % 100) : strlen(#t2);
(n & 8 ? mx1 : mx2) = a * 0.5;
spl0 += 0.000001 * (vv + tt + lp + lw + pp + mx1);
