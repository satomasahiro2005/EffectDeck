<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- 画面には出ない。一覧の 2 行目は下の UTTypeDescription のほう。 -->
	<key>CFBundleDisplayName</key>
	<string>EffeTune</string>
	<key>EXAppExtensionAttributes</key>
	<dict>
		<key>EXExtensionPointIdentifier</key>
		<string>com.apple.media-device-extension</string>
	</dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>media-device-protocol.ai.nemut.effetune</string>
			<!-- **コントロールセンターの一覧の 2 行目はこの字。**実機で確認した。
			     iOS はこの字を MDE のプロトコル名として扱い、エラーにもそのまま出す
			     （「"Music" does not support playing media with "…"」。#12）。
			     音の形（48 kHz, 32-bit float）を書くと「ミュージックがその形式を
			     扱えない」と読めるので、プロトコルの名前にしてある。
			     **替えると更新した人は 1 回再起動するまで繋がらない**（#2・#12）。
			     アプリ側は ProtocolMigration で再起動の案内を出している。
			     識別子（UTTypeIdentifier）のほうは替えないこと。替えると別の型に
			     なって登録が入れ替わる。 -->
			<key>UTTypeDescription</key>
			<string>EffectDeck Audio</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.media-sharing-protocol</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
