<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>EffectDeck</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>EffectDeck uses playAndRecord so it can send the processed sound back to the built-in speaker. It never records or stores audio.</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- 暗号を使わない。入れておかないと、アップロードのたびに
	     App Store Connect 側で「輸出コンプライアンスが無い」と言われ、
	     API か web で答えるまでベータ審査へ出せない。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- 共有シートとほかのアプリの「このアプリで開く」から音のファイルを受ける。
	     受けたものは IR として取り込む（PipelineView の .onOpenURL → ETInbox）。

	     **public.audio は名乗らない。**あれにすると mp3 や m4a でも候補に出るが、
	     IR の読み手が受けるのは WAV / FLAC / AIFF / CAF だけ（IRLoader）なので、
	     受けたあとに失敗するだけになる。読める型だけを並べる。

	     **Rank は Alternate。**Owner にすると音のファイルの既定の開き手を奪う。

	     新しい UTI は作らない。どれも系が既に持っている型なので、
	     UTImportedTypeDeclarations は要らない。拡張バンドルの
	     UTExportedTypeDeclarations（出力先の名前）には触っていない。 -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Impulse Response</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.microsoft.waveform-audio</string>
				<string>org.xiph.flac</string>
				<string>public.aiff-audio</string>
				<string>com.apple.coreaudio-format</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>JSFX Source</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.plain-text</string>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
